#!/sbin/sh
# Magisk 模块安装入口（最小实现）：解压模块文件，执行 customize.sh
umask 022
OUTFD=$2
ZIPFILE=$3

ui_print() {
  echo -e "ui_print $1\nui_print" > /proc/self/fd/$OUTFD
}

# Magisk 安装器会设置 MODPATH；KernelSU/APatch 环境下若未设置则兜底
if [ -z "$MODPATH" ]; then
  MODPATH="/data/adb/modules/oneplus_pad_pro_sched"
fi
mkdir -p "$MODPATH"

ui_print "- 正在解压 OnePlus Pad Pro 性能调度模块..."
unzip -o "$ZIPFILE" -x 'META-INF/*' -d "$MODPATH" >&2

if [ -f "$MODPATH/customize.sh" ]; then
  # customize.sh 里用到的 Magisk 安装函数在部分环境不存在时，定义空实现兜底
  set_perm() { chown "$2:$3" "$1" 2>/dev/null; chmod "$4" "$1" 2>/dev/null; return 0; }
  set_perm_recursive() { return 0; }
  . "$MODPATH/customize.sh"
fi

ui_print "- 完成，重启生效。"
exit 0
